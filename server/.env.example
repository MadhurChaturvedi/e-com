PORT=5000
NODE_ENV=development
CLIENT_URL=https://e-com-phi-beige.vercel.app,http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce
# Optional reverse-proxy hop count; configure to match your trusted deployment topology.
TRUST_PROXY=0
# Tune against MongoDB capacity and the number of application instances.
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=0
JWT_ACCESS_SECRET=super_secret_access_jwt_key_development_change_in_production
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_development_change_in_production
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
ADMIN_EMAIL=admin@store.com
ADMIN_PASSWORD=Admin@123456

# Redis High-Speed In-Memory Caching & Session Acceleration
# Connection URL format: redis://[user:password@]host[:port][/db] or rediss:// for TLS (e.g. Upstash, Redis Cloud)
# If left empty, NovaStore automatically uses a high-performance in-memory cache fallback.
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=true
CACHE_TTL_DEFAULT=300
CACHE_PREFIX=novastore:
